{
  "expo": {
    "name": "deepth_app",
    "slug": "deepth_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothPeripheralUsageDescription": "이 앱은 BLE 기기(눈 마사지기)와 연결하고 펌웨어를 전송하기 위해 블루투스를 사용합니다."
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "package": "kr.mdd.deepthsmart"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "이 앱은 BLE 기기(눈 마사지기)와 연결하고 펌웨어를 전송하기 위해 블루투스를 사용합니다."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "66e58bec-daf7-41ef-8998-5c36e41317df"
      }
    },
    "owner": "kjh_expo"
  }
}
